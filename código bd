-- Función para recalcular categoría del cliente por DNI
CREATE OR REPLACE FUNCTION fn_actualizar_categoria(p_dni VARCHAR)
RETURNS VOID AS $$
DECLARE
    v_categoria_id BIGINT;
BEGIN
    SELECT categoria_id INTO v_categoria_id
    FROM categoria_cliente
    WHERE millas_minimas <= (SELECT millas_acumuladas FROM cliente WHERE dni = p_dni)
    ORDER BY millas_minimas DESC
    LIMIT 1;

    UPDATE cliente 
    SET categoria_id = v_categoria_id 
    WHERE dni = p_dni;
END;
$$ LANGUAGE plpgsql;

-- Trigger: Generación y acumulación de millas al insertar una reserva
CREATE OR REPLACE FUNCTION fn_trg_procesar_reserva()
RETURNS TRIGGER AS $$
DECLARE
    v_millas INTEGER := 0;
BEGIN
    -- Obtener millas del pasaje si existe
    IF NEW.pasaje_id IS NOT NULL THEN
        SELECT millas_otorgadas INTO v_millas FROM pasaje WHERE pasaje_id = NEW.pasaje_id;
    END IF;

    NEW.millas_generadas := COALESCE(v_millas, 0);

    -- Si genera millas, actualiza al cliente y recalcula su categoría
    IF NEW.millas_generadas > 0 THEN
        UPDATE cliente
        SET millas_acumuladas = millas_acumuladas + NEW.millas_generadas
        WHERE dni = NEW.cliente_dni;

        PERFORM fn_actualizar_categoria(NEW.cliente_dni);
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_procesar_reserva
BEFORE INSERT ON reserva
FOR EACH ROW
EXECUTE FUNCTION fn_trg_procesar_reserva();

-- Trigger: Validación de catálogo exclusivo al agregar líneas de venta
CREATE OR REPLACE FUNCTION fn_trg_validar_linea_venta()
RETURNS TRIGGER AS $$
DECLARE
    v_categoria_min BIGINT;
    v_cliente_dni VARCHAR(15);
    v_nivel_cliente INTEGER;
    v_nivel_requerido INTEGER;
BEGIN
    SELECT categoria_minima_id INTO v_categoria_min
    FROM vino WHERE vino_id = NEW.vino_id;

    IF v_categoria_min IS NOT NULL THEN
        SELECT cliente_dni INTO v_cliente_dni FROM venta_vino WHERE venta_id = NEW.venta_id;
        
        SELECT cc.nivel INTO v_nivel_cliente
        FROM cliente c 
        JOIN categoria_cliente cc ON c.categoria_id = cc.categoria_id
        WHERE c.dni = v_cliente_dni;

        SELECT nivel INTO v_nivel_requerido
        FROM categoria_cliente WHERE categoria_id = v_categoria_min;

        IF v_nivel_cliente < v_nivel_requerido THEN
            RAISE EXCEPTION 'El cliente no alcanza la categoría mínima requerida para comprar este vino exclusivo.';
        END IF;
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_validar_linea_venta
BEFORE INSERT ON linea_venta_vino
FOR EACH ROW
EXECUTE FUNCTION fn_trg_validar_linea_venta();

-- Función RPC / Procedimiento: Registrar Venta Completa
CREATE OR REPLACE FUNCTION fn_registrar_venta_vino(
    p_cliente_dni VARCHAR,
    p_vino_id BIGINT,
    p_cantidad INTEGER
)
RETURNS BIGINT AS $$
DECLARE
    v_venta_id BIGINT;
    v_descuento_pct NUMERIC(5,2);
    v_precio NUMERIC(10,2);
    v_subtotal NUMERIC(12,2);
BEGIN
    -- Obtener descuento de la categoría del cliente
    SELECT cc.descuento_pct INTO v_descuento_pct
    FROM cliente c 
    JOIN categoria_cliente cc ON c.categoria_id = cc.categoria_id
    WHERE c.dni = p_cliente_dni;

    -- Obtener precio del vino
    SELECT precio INTO v_precio FROM vino WHERE vino_id = p_vino_id;

    -- Calcular subtotal
    v_subtotal := v_precio * p_cantidad * (1 - (v_descuento_pct / 100));

    -- Registrar Venta
    INSERT INTO venta_vino (cliente_dni, fecha, total, descuento_aplicado)
    VALUES (p_cliente_dni, NOW(), v_subtotal, v_descuento_pct)
    RETURNING venta_id INTO v_venta_id;

    -- Registrar Línea
    INSERT INTO linea_venta_vino (venta_id, vino_id, cantidad, precio_unitario)
    VALUES (v_venta_id, p_vino_id, p_cantidad, v_precio);

    -- Actualizar Stock
    UPDATE stock 
    SET cantidad = cantidad - p_cantidad, 
        ultima_actualizacion = NOW()
    WHERE vino_id = p_vino_id;

    -- Registrar Movimiento de Stock
    INSERT INTO movimiento_stock (vino_id, tipo, cantidad)
    VALUES (p_vino_id, 'SALIDA', p_cantidad);

    RETURN v_venta_id;
END;
$$ LANGUAGE plpgsql;


