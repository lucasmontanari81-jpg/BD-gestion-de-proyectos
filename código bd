CREATE TABLE pais (
    codigo CHAR(3) PRIMARY KEY,
    nombre VARCHAR(80) NOT NULL
);

CREATE TABLE provincia (
    provincia_id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    pais_codigo CHAR(3) NOT NULL REFERENCES pais(codigo) ON DELETE CASCADE
);

CREATE TABLE ciudad (
    ciudad_id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    provincia_id BIGINT NOT NULL REFERENCES provincia(provincia_id) ON DELETE CASCADE
);

CREATE TABLE aeropuerto (
    codigo VARCHAR(4) PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    cant_vuelos_prom INTEGER DEFAULT 0,
    pais_codigo CHAR(3) NOT NULL REFERENCES pais(codigo) ON DELETE CASCADE
);


-- 2. CLIENTE Y FIDELIZACIÓN


CREATE TABLE categoria_cliente (
    categoria_id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre VARCHAR(30) NOT NULL,
    nivel INTEGER UNIQUE NOT NULL,
    millas_minimas INTEGER NOT NULL,
    descuento_pct NUMERIC(5,2) DEFAULT 0 NOT NULL,
    acceso_exclusivo BOOLEAN DEFAULT FALSE NOT NULL
);

CREATE TABLE cliente (
    dni VARCHAR(15) PRIMARY KEY,
    nombre VARCHAR(60) NOT NULL,
    apellido VARCHAR(60) NOT NULL,
    email VARCHAR(120) UNIQUE,
    telefono VARCHAR(30),
    millas_acumuladas INTEGER DEFAULT 0 NOT NULL,
    categoria_id BIGINT NOT NULL REFERENCES categoria_cliente(categoria_id)
);

-- 3. TURISMO

CREATE TABLE agencia (
    agencia_id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    cant_empleados INTEGER CHECK (cant_empleados >= 0),
    direccion_fisica VARCHAR(200) NOT NULL
);

CREATE TABLE mayorista (
    mayorista_id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre VARCHAR(120) NOT NULL,
    facturacion_prom_anual NUMERIC(14,2)
);

CREATE TABLE agencia_mayorista (
    agencia_id BIGINT REFERENCES agencia(agencia_id) ON DELETE CASCADE,
    mayorista_id BIGINT REFERENCES mayorista(mayorista_id) ON DELETE CASCADE,
    PRIMARY KEY (agencia_id, mayorista_id)
);

CREATE TABLE hotel (
    hotel_id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    categoria INTEGER,
    direccion VARCHAR(200),
    ciudad_id BIGINT NOT NULL REFERENCES ciudad(ciudad_id)
);

CREATE TABLE circuito (
    circuito_id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    denominacion VARCHAR(120) NOT NULL,
    cant_personas_anual_prom INTEGER
);

CREATE TABLE circuito_ciudad (
    circuito_id BIGINT REFERENCES circuito(circuito_id) ON DELETE CASCADE,
    ciudad_id BIGINT REFERENCES ciudad(ciudad_id) ON DELETE CASCADE,
    PRIMARY KEY (circuito_id, ciudad_id)
);

CREATE TABLE pasaje (
    pasaje_id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    descripcion VARCHAR(200),
    horario_vuelo TIMESTAMPTZ,
    millas_otorgadas INTEGER DEFAULT 0 NOT NULL,
    aero_salida_id VARCHAR(4) NOT NULL REFERENCES aeropuerto(codigo),
    aero_llegada_id VARCHAR(4) NOT NULL REFERENCES aeropuerto(codigo)
);

CREATE TABLE reserva (
    reserva_id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    fecha_reserva TIMESTAMPTZ DEFAULT NOW() NOT NULL,
    codigo_vuelo VARCHAR(20),
    millas_generadas INTEGER DEFAULT 0,
    cliente_dni VARCHAR(15) NOT NULL REFERENCES cliente(dni),
    agencia_id BIGINT NOT NULL REFERENCES agencia(agencia_id),
    pasaje_id BIGINT REFERENCES pasaje(pasaje_id),
    hotel_id BIGINT REFERENCES hotel(hotel_id),
    circuito_id BIGINT REFERENCES circuito(circuito_id),
    CONSTRAINT ck_reserva_tipo CHECK (pasaje_id IS NOT NULL OR hotel_id IS NOT NULL OR circuito_id IS NOT NULL)
);

CREATE TABLE participante (
    participante_dni VARCHAR(15) PRIMARY KEY,
    nombre VARCHAR(60) NOT NULL,
    apellido VARCHAR(60) NOT NULL,
    cliente_dni VARCHAR(15) NOT NULL REFERENCES cliente(dni)
);

CREATE TABLE reserva_participante (
    reserva_id BIGINT REFERENCES reserva(reserva_id) ON DELETE CASCADE,
    participante_dni VARCHAR(15) REFERENCES participante(participante_dni) ON DELETE CASCADE,
    nro_asiento VARCHAR(10),
    PRIMARY KEY (reserva_id, participante_dni)
);


-- 4. VINOTECA

CREATE TABLE bodega (
    bodega_id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre VARCHAR(120) NOT NULL,
    contacto VARCHAR(120)
);

CREATE TABLE vino (
    vino_id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre VARCHAR(200) NOT NULL,
    varietal VARCHAR(100),
    anio INTEGER,
    precio NUMERIC(10,2) CHECK (precio > 0),
    bodega_id BIGINT NOT NULL REFERENCES bodega(bodega_id),
    categoria_minima_id BIGINT REFERENCES categoria_cliente(categoria_id)
);

CREATE TABLE stock (
    stock_id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    vino_id BIGINT UNIQUE NOT NULL REFERENCES vino(vino_id) ON DELETE CASCADE,
    cantidad INTEGER DEFAULT 0 NOT NULL CHECK (cantidad >= 0),
    ultima_actualizacion TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE movimiento_stock (
    mov_id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    vino_id BIGINT NOT NULL REFERENCES vino(vino_id),
    tipo VARCHAR(20) CHECK (tipo IN ('INGRESO', 'SALIDA')),
    cantidad INTEGER NOT NULL CHECK (cantidad > 0),
    fecha TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE venta_vino (
    venta_id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    cliente_dni VARCHAR(15) NOT NULL REFERENCES cliente(dni),
    fecha TIMESTAMPTZ DEFAULT NOW(),
    total NUMERIC(12,2),
    descuento_aplicado NUMERIC(5,2) DEFAULT 0
);

CREATE TABLE linea_venta_vino (
    linea_id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    venta_id BIGINT NOT NULL REFERENCES venta_vino(venta_id) ON DELETE CASCADE,
    vino_id BIGINT NOT NULL REFERENCES vino(vino_id),
    cantidad INTEGER NOT NULL CHECK (cantidad > 0),
    precio_unitario NUMERIC(10,2) NOT NULL
);

